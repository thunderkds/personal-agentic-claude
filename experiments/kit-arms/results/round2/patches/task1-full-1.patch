     assert tally("list", "--since", "yesterday").returncode == 2
 
 
+def test_summary_month(tally):
+    tally("add", "10", "food", "--date", "2026-02-28")
+    tally("add", "5", "books", "--date", "2026-02-10")
+    tally("add", "20", "food", "--date", "2026-03-01")
+    tally("add", "3", "food", "--date", "2026-03-31")
+    out = tally("summary", "--month", "2026-03").stdout
+    assert "$23.00" in out and "books" not in out
+    assert "total" in out and "$38.00" not in out
+
+
+def test_summary_month_no_expenses(tally):
+    tally("add", "10", "food", "--date", "2026-02-28")
+    result = tally("summary", "--month", "2026-04")
+    assert result.returncode == 0
+    assert result.stdout.strip() == "No expenses."
+
+
+def test_summary_bad_month_exits_2(tally):
+    tally("add", "10", "food", "--date", "2026-03-01")
+    for bad in ("2026-13", "2026-00", "2026-3", "march", ""):
+        result = tally("summary", "--month", bad)
+        assert result.returncode == 2, bad
+        assert result.stderr.startswith("error:"), bad
