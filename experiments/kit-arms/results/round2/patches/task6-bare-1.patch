diff --git a/src/tally/money.py b/src/tally/money.py
index 755de5c..4b67e58 100644
--- a/src/tally/money.py
+++ b/src/tally/money.py
@@ -8,23 +8,36 @@ import re
 _AMOUNT_RE = re.compile(r"^(\d{1,9})(?:\.(\d{1,2}))?$")
 
 
-def parse_amount(text):
+def parse_amount(text, allow_negative=False):
     """Parse a user-typed amount like "12", "12.5" or "12.50" into cents.
 
     A leading "$" and thousands separators are accepted ("$1,200.00").
-    Raises ValueError for anything else.
+    With allow_negative, a leading "-" (before the "$") makes a refund:
+    "-15.00" and "-$15.00" both give -1500. Raises ValueError for anything else.
     """
-    cleaned = text.strip().lstrip("$").replace(",", "")
+    cleaned = text.strip().replace(",", "")
+    negative = cleaned.startswith("-")
+    cleaned = cleaned.removeprefix("-").lstrip("$")
     match = _AMOUNT_RE.match(cleaned)
-    if not match:
+    if not match or (negative and not allow_negative):
         raise ValueError(f"not a valid amount: {text!r}")
     whole, frac = match.group(1), match.group(2) or ""
-    return int(whole) * 100 + int(frac.ljust(2, "0") or 0)
+    cents = int(whole) * 100 + int(frac.ljust(2, "0") or 0)
+    return -cents if negative else cents
 
 
 def to_plain(cents):
     """Cents as the plain decimal string stored in the data file: 1250 -> "12.50"."""
-    return f"{cents // 100}.{cents % 100:02d}"
+    sign = "-" if cents < 0 else ""
+    whole, rem = divmod(abs(cents), 100)
+    return f"{sign}{whole}.{rem:02d}"
+
+
+def format_dollars(cents):
+    """Cents for display: 1250 -> "$12.50", -1500 -> "-$15.00"."""
+    sign = "-" if cents < 0 else ""
+    whole, rem = divmod(abs(cents), 100)
+    return f"{sign}${whole:,}.{rem:02d}"
 
 
