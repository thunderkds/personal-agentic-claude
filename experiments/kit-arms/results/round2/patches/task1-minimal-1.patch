diff --git a/src/tally/cli.py b/src/tally/cli.py
index cde1108..cfb6d76 100644
--- a/src/tally/cli.py
+++ b/src/tally/cli.py
@@ -38,6 +38,12 @@ def cmd_list(args):
 
 def cmd_summary(args):
     expenses = storage.load()
+    if args.month:
+        try:
+            month = dt.datetime.strptime(args.month, "%Y-%m")
+        except ValueError:
+            raise ValueError(f"bad month {args.month!r}, expected YYYY-MM") from None
+        expenses = [e for e in expenses if (e.date.year, e.date.month) == (month.year, month.month)]
     if not expenses:
         print("No expenses.")
         return 0
@@ -108,6 +114,7 @@ def build_parser():
     lst.set_defaults(func=cmd_list)
 
     summary = sub.add_parser("summary", help="totals per category")
+    summary.add_argument("--month", help="only expenses in this month, YYYY-MM")
     summary.set_defaults(func=cmd_summary)
 
     top = sub.add_parser("top", help="the biggest single expenses")
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 97e72cb..7cdbfbb 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -15,6 +15,30 @@ def test_summary_totals(tally):
     assert "total" in out and "$52.50" in out
 
 
+def test_summary_month(tally):
+    tally("add", "10", "food", "--date", "2026-02-28")
+    tally("add", "5", "food", "--date", "2026-03-01")
+    tally("add", "40", "books", "--date", "2026-03-31")
+    tally("add", "7", "food", "--date", "2026-04-01")
+    out = tally("summary", "--month", "2026-03").stdout
+    assert "$45.00" in out and "$40.00" in out and "$5.00" in out
+    assert "$10.00" not in out and "$7.00" not in out
+
+
+def test_summary_month_empty(tally):
+    tally("add", "10", "food", "--date", "2026-02-28")
+    result = tally("summary", "--month", "2026-03")
+    assert result.returncode == 0
+    assert result.stdout.strip() == "No expenses."
+
+
+def test_bad_month_exits_2(tally):
+    for bad in ("2026-13", "march"):
+        result = tally("summary", "--month", bad)
+        assert result.returncode == 2
+        assert "error:" in result.stderr
+
+
 def test_bad_amount_exits_2(tally):
     result = tally("add", "twelve", "food")
     assert result.returncode == 2
