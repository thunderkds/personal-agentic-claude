diff --git a/src/tally/cli.py b/src/tally/cli.py
index cde1108..3d93966 100644
--- a/src/tally/cli.py
+++ b/src/tally/cli.py
@@ -36,8 +36,24 @@ def cmd_list(args):
     return 0
 
 
+def parse_month(text):
+    """'YYYY-MM' -> (year, month); ValueError if malformed."""
+    parts = text.split("-")
+    if (
+        len(parts) != 2
+        or not (len(parts[0]) == 4 and parts[0].isascii() and parts[0].isdigit())
+        or not (len(parts[1]) == 2 and parts[1].isascii() and parts[1].isdigit())
+        or not 1 <= int(parts[1]) <= 12
+    ):
+        raise ValueError(f"bad month {text!r}: expected YYYY-MM")
+    return int(parts[0]), int(parts[1])
+
+
 def cmd_summary(args):
     expenses = storage.load()
+    if args.month:
+        year, month = parse_month(args.month)
+        expenses = [e for e in expenses if (e.date.year, e.date.month) == (year, month)]
     if not expenses:
         print("No expenses.")
         return 0
@@ -108,6 +124,7 @@ def build_parser():
     lst.set_defaults(func=cmd_list)
 
     summary = sub.add_parser("summary", help="totals per category")
+    summary.add_argument("--month", help="only expenses in this month, YYYY-MM")
     summary.set_defaults(func=cmd_summary)
 
     top = sub.add_parser("top", help="the biggest single expenses")
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 97e72cb..b05a79a 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -15,6 +15,28 @@ def test_summary_totals(tally):
     assert "total" in out and "$52.50" in out
 
 
+def test_summary_month(tally):
+    tally("add", "10", "food", "--date", "2026-02-28")
+    tally("add", "5", "food", "--date", "2026-03-01")
+    tally("add", "7", "books", "--date", "2026-03-31")
+    tally("add", "100", "food", "--date", "2026-04-01")
+    out = tally("summary", "--month", "2026-03").stdout
+    assert "$5.00" in out and "$7.00" in out and "$12.00" in out
+    assert "$10.00" not in out and "$100.00" not in out
+
+
+def test_summary_month_empty(tally):
+    tally("add", "10", "food", "--date", "2026-02-28")
+    assert tally("summary", "--month", "2026-03").stdout.strip() == "No expenses."
+
+
+def test_bad_summary_month_exits_2(tally):
+    for bad in ("2026-13", "2026-00", "march", "2026-3", "2026"):
+        result = tally("summary", "--month", bad)
+        assert result.returncode == 2, bad
+        assert "error:" in result.stderr
+
+
 def test_bad_amount_exits_2(tally):
     result = tally("add", "twelve", "food")
     assert result.returncode == 2
