diff --git a/src/tally/models.py b/src/tally/models.py
index 7b548f2..56f1e6f 100644
--- a/src/tally/models.py
+++ b/src/tally/models.py
@@ -56,6 +56,18 @@ def parse_date(text):
         raise ValueError(f"not a valid date (use YYYY-MM-DD): {text!r}") from None
 
 
+def parse_month(text):
+    """Parse "YYYY-MM" into (year, month). Raises ValueError with a readable message."""
+    text = text.strip()
+    try:
+        if len(text) != 7:
+            raise ValueError
+        first = dt.date.fromisoformat(text + "-01")
+    except ValueError:
+        raise ValueError(f"not a valid month (use YYYY-MM): {text!r}") from None
+    return first.year, first.month
+
+
 def normalize_category(text):
     """User input "Eating Out" -> "eating-out"."""
     return "-".join(text.strip().lower().split())
