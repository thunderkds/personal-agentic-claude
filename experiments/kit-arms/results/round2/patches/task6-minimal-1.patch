@@ -53,3 +53,26 @@ def test_due(tally, data_file):
     assert tally("due", "--today", "2026-03-10").stdout.strip() == "Nothing due."
     out = tally("due", "--today", "2026-04-25").stdout
     assert "rent" in out and "phone" in out
+
+
+def test_refund_add_list_summary_top(tally):
+    assert tally("add", "40", "groceries", "--date", "2026-03-01").returncode == 0
+    assert tally("add", "-15.00", "groceries", "returned the blender", "--date", "2026-03-02").returncode == 0
+    assert "-$15.00" in tally("list").stdout
+    assert "-$15.00" in tally("top", "5").stdout
+    out = tally("summary").stdout
+    assert "$25.00" in out and "-$15.00" not in out
+
+
+def test_summary_negative_total(tally):
+    tally("add", "-15", "food", "--date", "2026-03-02")
+    assert "-$15.00" in tally("summary").stdout
+
+
+def test_zero_still_rejected(tally):
+    result = tally("add", "0", "food")
+    assert result.returncode == 2 and "error:" in result.stderr
+
+
+def test_split_still_rejects_negative(tally):
+    assert tally("split", "-30", "3").returncode == 2
