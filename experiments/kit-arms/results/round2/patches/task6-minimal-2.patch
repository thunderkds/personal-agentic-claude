diff --git a/src/tally/money.py b/src/tally/money.py
index 755de5c..97b6c2d 100644
--- a/src/tally/money.py
+++ b/src/tally/money.py
@@ -22,9 +22,29 @@ def parse_amount(text):
     return int(whole) * 100 + int(frac.ljust(2, "0") or 0)
 
 
+def parse_signed_amount(text):
+    """Like parse_amount, but a leading "-" makes it a negative amount (a refund)."""
+    cleaned = text.strip()
+    if cleaned.startswith("-"):
+        rest = cleaned[1:]
+        if rest != rest.strip():
+            raise ValueError(f"not a valid amount: {text!r}")
+        return -parse_amount(rest)
+    return parse_amount(cleaned)
+
+
 def to_plain(cents):
     """Cents as the plain decimal string stored in the data file: 1250 -> "12.50"."""
-    return f"{cents // 100}.{cents % 100:02d}"
+    sign = "-" if cents < 0 else ""
+    whole, frac = divmod(abs(cents), 100)
+    return f"{sign}{whole}.{frac:02d}"
+
+
+def format_cents(cents):
+    """Cents for display: 1250 -> "$12.50", -1500 -> "-$15.00"."""
+    sign = "-" if cents < 0 else ""
+    whole, frac = divmod(abs(cents), 100)
+    return f"{sign}${whole:,}.{frac:02d}"
 
 
