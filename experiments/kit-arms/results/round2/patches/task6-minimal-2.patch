diff --git a/tests/test_cli.py b/tests/test_cli.py
index 97e72cb..884ebcb 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -53,3 +53,23 @@ def test_due(tally, data_file):
     assert tally("due", "--today", "2026-03-10").stdout.strip() == "Nothing due."
     out = tally("due", "--today", "2026-04-25").stdout
     assert "rent" in out and "phone" in out
+
+
+def test_refund_flow(tally):
+    tally("add", "20.00", "groceries", "blender", "--date", "2026-03-01")
+    added = tally("add", "-15.00", "groceries", "returned the blender", "--date", "2026-03-02")
+    assert added.returncode == 0
+    assert "-$15.00" in added.stdout
+    listing = tally("list")
+    assert "-$15.00" in listing.stdout
+    assert "-$15.00" not in tally("top", "5").stdout.splitlines()[0]
+    assert "-$15.00" in tally("top", "5").stdout
+    summary = tally("summary").stdout
+    assert "$5.00" in summary and "-" not in summary
+    assert tally("add", "-0.50", "snacks").returncode == 0
+    assert "-$0.50" in tally("list", "--category", "snacks").stdout
+
+
+def test_zero_amount_still_rejected(tally):
+    assert tally("add", "0", "food").returncode == 2
+    assert tally("add", "-0.00", "food").returncode == 2
