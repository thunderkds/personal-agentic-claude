+def test_note_with_comma_and_quote_round_trips(tmp_path):
+    path = tmp_path / "e.csv"
+    a = Expense(dt.date(2026, 1, 5), 1840, "eating-out", "pho, then bubble tea")
+    b = Expense(dt.date(2026, 1, 6), 500, "food", 'the "good" place')
+    storage.append(a, path)
+    storage.append(b, path)
+    assert storage.load(path) == [a, b]
+    storage.save_all([a, b], path)
